{
  "name": "contratos-web",
  "version": "2.7.1",
  "private": true,
  "type": "module",
  "description": "Pesquisa de editais, atas e contratos no PNCP diretamente no navegador, com distribuição estática",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "test": "node --test --test-concurrency=4 test/*.test.js",
    "test:coverage": "node --test --test-concurrency=4 --experimental-test-coverage --test-coverage-exclude=\"test/**\" --test-coverage-exclude=vite.config.js --test-coverage-lines=80 --test-coverage-branches=89 --test-coverage-functions=85 test/*.test.js",
    "test:budget": "node test/performance-budget.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.contracts.json",
    "format": "prettier --write \"{src,public,test,types}/**/*.{js,mjs,ts,css,html}\" \"*.{js,json}\" \"types/*.ts\"",
    "build": "vite build",
    "build:qa": "vite build && vite build --mode test",
    "preview": "vite preview",
    "test:browser": "node test/browser-smoke.mjs",
    "format:check": "prettier --check \"{src,public,test,types}/**/*.{js,mjs,ts,css,html}\" \"*.{js,json}\" \"types/*.ts\""
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "axe-core": "4.14.0",
    "eslint": "10.14.0",
    "globals": "17.13.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
