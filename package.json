{
  "name": "compras-web-pncp",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "Pesquisa PNCP diretamente no navegador, com distribuição estática",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "demo": "vite --mode demo",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:budget": "node test/performance-budget.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"{src,public,test}/**/*.{js,mjs,css,html}\" \"vite.config.js\" \"eslint.config.js\"",
    "build": "vite build",
    "preview": "vite preview",
    "test:browser": "node test/browser-smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "vite": "8.3.4"
  }
}
