[
  {
    "label": "Dev",
    "command": "npm run dev",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never"
  },
  {
    "label": "Demo",
    "command": "npm run demo",
    "cwd": "$ZED_WORKTREE_ROOT",
